# Environment variables for the Bedrock Activity Dashboard backend.
# Copy to `.env` and adjust. Loaded by backend/app/config.py (pydantic-settings).
# Variable names are case-insensitive. NEVER commit a real .env (it is gitignored).

# --- Database ---
# Local dev: a full connection URL is all you need.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedrock_dashboard
# In AWS (ECS) these components are injected and DATABASE_URL is rebuilt from them
# plus Secrets Manager. Leave unset for local dev.
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=bedrock_dashboard
# DB_SECRET_ARN=

# --- AWS ---
AWS_REGION=us-west-2
# Prefer an AWS profile or IAM role over static keys. Only set these for local
# testing if absolutely necessary — never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Application ---
APP_NAME=Bedrock Activity Dashboard
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Alerts ---
# SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:bedrock-dashboard-alerts

# --- Data sources ---
# Comma-separated regions to query CloudTrail for Bedrock events (optional).
CLOUDTRAIL_REGIONS=
BEDROCK_LOG_GROUP=/aws/bedrock/model-invocations

# --- Bedrock Agent (AI Agent Chat) ---
# Default is Amazon Nova Pro. Alternatives: us.anthropic.claude-sonnet-4-6,
# us.anthropic.claude-haiku-4-5-20251001-v1:0, us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# BEDROCK_REGION=us-west-2

# --- Cognito authentication (backend) ---
# Required whenever AUTH_ENABLED=true (the default) — there is no
# environment-agnostic default, and app.auth raises RuntimeError at import
# time if AUTH_ENABLED is true and either value below is unset. Get these
# from your Cognito User Pool / App Client (not secrets — safe to reference in
# CDK/CFN outputs, but still environment-specific so not hardcoded here).
# COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-west-2
# Set to false to bypass Cognito verification entirely (local dev without a
# pool configured); every request is then treated as an admin-equivalent
# "system" user. Never set false in a deployed environment.
AUTH_ENABLED=true

# --- Cognito authentication (frontend build-time) ---
# Consumed by frontend/src/auth/cognito.ts via Vite (VITE_* vars are inlined
# into the JS bundle at `npm run build` time — they are not secrets, but are
# environment-specific). Put these in frontend/.env.local for local dev, or
# export them before building for deploy (see build-and-deploy-frontend.sh).
# VITE_COGNITO_DOMAIN=https://your-domain-prefix.auth.us-west-2.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Prompt history at-rest encryption ---
# A 32-byte, URL-safe-base64 Fernet key. When set, Agent Chat message content
# is encrypted before being written to chat_messages and transparently
# decrypted on read. When unset, writes fall back to plaintext storage AND
# the admin Settings UI surfaces an explicit warning.
#
# Generate a key locally with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# In production, the Backend CDK stack provisions a Secrets Manager secret
# and injects it as this env var — do NOT put a real key in version control.
# PROMPT_HISTORY_ENCRYPTION_KEY=
